{
  "manifest_version": 2,
  "id": "local.bilibili-autopilot",
  "name": "B站自主浏览与评论",
  "version": "0.8.0",
  "description": "自主决定何时浏览 B 站和发表评论，检查别人对麦麦评论的回复并决定是否接话，支持预览、管理页、限额和持久化去重。",
  "author": {
    "name": "sakura桜花",
    "url": "https://github.com/namchengwuqiu"
  },
  "urls": {
    "repository": "https://github.com/namchengwuqiu/bilibili_autopilot",
    "homepage": "https://github.com/namchengwuqiu/bilibili_autopilot",
    "documentation": "https://github.com/namchengwuqiu/bilibili_autopilot#readme",
    "issues": "https://github.com/namchengwuqiu/bilibili_autopilot/issues"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.10",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": "==17.4.2"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8,<9"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10"
    }
  ],
  "capabilities": [
    "llm.generate",
    "config.get",
    "send.text",
    "send.image",
    "chat.get_group_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "play",
      "background": "#E7F9FF"
    }
  }
}
